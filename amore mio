<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ho una domanda per te...</title>
    <!-- Libreria esterna per l'effetto coriandoli (Confetti) -->
    <script src="https://jsdelivr.net"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #ffe5ec, #ffc2d1);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            overflow: hidden;
        }

        .container {
            background: rgba(255, 255, 255, 0.85);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            max-width: 500px;
            width: 90%;
            backdrop-filter: blur(10px);
            transition: all 0.5s ease;
        }

        h1 {
            color: #ff477e;
            font-size: 2.2rem;
            margin-bottom: 20px;
            line-height: 1.3;
        }

        .gif-container img {
            width: 180px;
            height: 180px;
            margin-bottom: 25px;
            border-radius: 10px;
        }

        .buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-top: 20px;
            position: relative;
            height: 60px;
        }

        button {
            padding: 12px 35px;
            font-size: 1.2rem;
            font-weight: bold;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.2s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        #yesBtn {
            background-color: #ff477e;
            color: white;
        }

        #yesBtn:hover {
            background-color: #ff7096;
            transform: scale(1.1);
        }

        #noBtn {
            background-color: #94a3b8;
            color: white;
            position: absolute;
        }

        .hidden {
            display: none;
        }

        .success-message {
            font-size: 1.5rem;
            color: #ff477e;
            font-weight: bold;
            line-height: 1.5;
        }
    </style>
</head>
<body>

    <div class="container" id="mainContainer">
        <!-- Puoi cambiare questa GIF sostituendo il link tra le virgolette con una a tua scelta -->
        <div class="gif-container">
            <img id="statusGif" src="https://giphy.com" alt="Cute GIF">
        </div>
        
        <h1 id="questionText">Vuoi essere la mia ragazza? ❤️</h1>

        <div class="buttons" id="btnGroup">
            <button id="yesBtn">SÌ!</button>
            <button id="noBtn">No</button>
        </div>
    </div>

    <script>
        const noBtn = document.getElementById('noBtn');
        const yesBtn = document.getElementById('yesBtn');
        const container = document.getElementById('mainContainer');
        const questionText = document.getElementById('questionText');
        const btnGroup = document.getElementById('btnGroup');
        const statusGif = document.getElementById('statusGif');

        // Funzione per far scappare il pulsante NO
        function moveNoButton() {
            // Calcola lo spazio disponibile all'interno della pagina per non far uscire il bottone dallo schermo
            const padding = 50;
            const maxX = window.innerWidth - noBtn.offsetWidth - padding;
            const maxY = window.innerHeight - noBtn.offsetHeight - padding;

            // Genera coordinate casuali sul display
            const randomX = Math.floor(Math.random() * maxX);
            const randomY = Math.floor(Math.random() * maxY);

            // Sposta il pulsante modificando la sua posizione assoluta rispetto alla pagina
            noBtn.style.position = 'fixed';
            noBtn.style.left = randomX + 'px';
            noBtn.style.top = randomY + 'px';
        }

        // Il pulsante scappa sia se ci passa sopra con il mouse (PC) sia se lo tocca (Smartphone)
        noBtn.addEventListener('mouseenter', moveNoButton);
        noBtn.addEventListener('touchstart', (e) => {
            e.preventDefault(); // Impedisce il click accidentale su mobile
            moveNoButton();
        });

        // Cosa succede quando clicca SÌ
        yesBtn.addEventListener('click', () => {
            // Nasconde i pulsanti
            btnGroup.classList.add('hidden');
            
            // Cambia la domanda con un messaggio dolce
            questionText.innerHTML = "Sapevo che avresti detto di sì! 🥰<br><span style='font-size: 1.2rem; color: #64748b; font-weight: normal;'>Preparami psicologicamente per il nostro prossimo appuntamento!</span>";
            
            // Cambia la GIF con una di celebrazione
            statusGif.src = "https://giphy.com";

            // Lancia la pioggia di coriandoli continui per 3 secondi
            var duration = 3 * 1000;
            var end = Date.now() + duration;

            (function frame() {
                confetti({
                    particleCount: 5,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0, y: 0.8 }
                });
                confetti({
                    particleCount: 5,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1, y: 0.8 }
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            }());
        });
    </script>
</body>
</html>
